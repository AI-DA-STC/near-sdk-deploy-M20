# =============================================================================
# Deployment image for the M20 robot (ONE image, TWO containers).
#
# This is the SLIM, on-robot counterpart to .devcontainer/Dockerfile.
# It starts from ros-base (NO Gazebo, NO RViz, NO simulation stack) and builds
# the whole runtime workspace: the robot-agnostic nav_core (rl_deploy) AND the
# M20-specific bridge (m20_bridge). Two containers run from this one image:
#
#   nav_core   : ros2 launch rl_deploy   navigation.launch.py sim:=false
#   m20_bridge : ros2 launch m20_bridge  m20_bridge.launch.py
#
# The split is LOGICAL (two launch files); building one image keeps the offline
# transfer a single tar. Porting to another robot = add a <robot>_bridge package
# and point the bridge container at its launch file; nav_core is untouched.
# See docker-compose.yml for the wiring.
#
# Build (from the repo root, so the build context includes src/):
#   docker build -f Dockerfile.deploy -t m20-deploy:humble .
#
# Run (preferred): docker compose up
#   or manually, two containers:
#   docker run --rm -it --network=host --ipc=host m20-deploy:humble \
#       ros2 launch m20_bridge m20_bridge.launch.py
#   docker run --rm -it --network=host --ipc=host -v ~/maps:/root/ros_ws/maps \
#       m20-deploy:humble ros2 launch rl_deploy navigation.launch.py sim:=false
# =============================================================================
FROM ros:humble-ros-base

SHELL [ "/bin/bash", "-c" ]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        python3-pip \
        python3-colcon-common-extensions \
        python3-rosdep \
        ros-humble-navigation2 \
        ros-humble-robot-state-publisher \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-diagnostic-updater \
    && rm -rf /var/lib/apt/lists/*

# Full Nav2 stack (above) so every planner/controller/critic plugin is present
# regardless of what package.xml declares.
#
# RMW: the M20 Pro's onboard publishers (rsdriver lidar, AOS /IMU_YESENSE and
# /LIO_ODOM that m20_bridge subscribes) are FastDDS — CycloneDDS nodes cannot
# discover them, so the robot stack MUST run rmw_fastrtps_cpp. The FastDDS
# profile whitelists loopback (rsdriver + cross-container DDS on the GOS host)
# plus the internal NIC (m20_bridge -> AOS) and external NIC (laptop RViz).
# CycloneDDS remains installed and is still used in the DEV container
# (where it works around an in-container Nav2 lifecycle-service bug); if that
# bug ever reproduces on the robot under FastDDS, tune this profile rather
# than switching RMW.
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV FASTRTPS_DEFAULT_PROFILES_FILE=/root/ros_ws/config/fastdds_profile_gos.xml

WORKDIR /root/ros_ws

# Navigation Python deps into the system interpreter ros2 launch/run uses.
# requirements-deploy.txt is the minimal robot list — NOT requirements.txt
# (the dev-machine freeze), which pins local/CUDA/dev packages that would
# break this build.
COPY requirements-deploy.txt ./requirements-deploy.txt
RUN pip install --no-cache-dir -r requirements-deploy.txt

# Copy the workspace sources into the image. Initialise submodules on the host
# first: `git submodule update --init --recursive`.
#   - rf2o_laser_odometry (submodule): a normal ROS2 package -> colcon-built below.
#   - SWAGGER (submodule): a dev-only offline graph generator needing an NVIDIA GPU
#     (cucim-cu12). The robot only READS the .gml graph it produces, so SWAGGER is
#     NOT needed here. Drop it so colcon never sees its integration/ packages.
COPY src/ ./src/
RUN rm -rf src/src/SWAGGER

# FastDDS profile (see ENV above) + pyprojroot marker: navigation.launch.py
# locates the workspace root via pyprojroot.here(), which needs a marker file —
# .git is excluded by .dockerignore, so provide the canonical .here marker.
COPY config/fastdds_profile_gos.xml ./config/fastdds_profile_gos.xml
RUN touch /root/ros_ws/.here

# Resolve runtime dependencies.
#
# NOTE: package.xml currently has `<depend>ros_gz_bridge</depend>`, which is a
# SIM-ONLY dependency. On the robot you don't want the Ignition bridge; either
# make that line conditional in package.xml, e.g.
#     <depend condition="$SIM == 1">ros_gz_bridge</depend>
# or skip it here. We skip ros_gz* keys so rosdep doesn't pull Ignition:
# skip-keys:
#   ros_gz*      -> sim-only, not needed on the robot (see note above)
#   glim_ros     -> built from source separately (not on any apt repo)
#   cmake_modules-> stale rf2o key with no humble rosdep definition
RUN apt-get update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y \
         --skip-keys "ros_gz_bridge ros_gz_sim ros_gz glim_ros cmake_modules" \
    && rm -rf /var/lib/apt/lists/*

# Build the workspace (release, no test artifacts).
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# Auto-source ROS + the built overlay.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /root/ros_ws/install/setup.bash" >> /root/.bashrc

# Default entrypoint sources the overlay before running the given command.
# (printf, not echo: bash echo does not expand \n, which would corrupt the shebang)
RUN printf '%s\n' \
        '#!/bin/bash' \
        'set -e' \
        'source /opt/ros/${ROS_DISTRO}/setup.bash' \
        'source /root/ros_ws/install/setup.bash' \
        'exec "$@"' \
        > /ros_entrypoint.sh \
    && chmod +x /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
