
FROM ros:humble-ros-base

SHELL [ "/bin/bash", "-c" ]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        python3-pip \
        python3-dev \
        python3-numpy \
        python3-opencv \
        python3-colcon-common-extensions \
        python3-rosdep \
        libssl-dev \
        libeigen3-dev \
        ros-humble-navigation2 \
        ros-humble-robot-state-publisher \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-diagnostic-updater \
        ros-humble-cv-bridge \
    && rm -rf /var/lib/apt/lists/*


ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///root/ros_ws/config/cyclonedds_gos.xml
ENV FASTRTPS_DEFAULT_PROFILES_FILE=/root/ros_ws/config/fastdds_profile_gos.xml

WORKDIR /root/ros_ws

COPY requirements-deploy.txt ./requirements-deploy.txt
RUN pip install --no-cache-dir -r requirements-deploy.txt

COPY src/ ./src/
RUN rm -rf src/src/SWAGGER


RUN apt-get update \
    && rosdep update \
    && SKIP="ros_gz_bridge ros_gz_sim ros_gz glim_ros cmake_modules slam_toolbox" \
    && for attempt in 1 2 3; do \
         rosdep install --from-paths src --ignore-src -r -y --skip-keys "$SKIP" \
           && break; \
         echo ">>> rosdep attempt $attempt failed; repairing dpkg state (see QEMU note above)"; \
         dpkg --configure -a || true; \
         sleep 2; \
       done \
    && rosdep install --from-paths src --ignore-src -r -y --skip-keys "$SKIP" \
    && rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && export MAKEFLAGS=-j8 \
    && CMAKE_ARGS="-DCMAKE_BUILD_TYPE=Release \
         -Dorocos_kdl_LIBRARY=/usr/lib/aarch64-linux-gnu/liborocos-kdl.so \
         -DOPENSSL_INCLUDE_DIR=/usr/include \
         -DOPENSSL_CRYPTO_LIBRARY=/usr/lib/aarch64-linux-gnu/libcrypto.so \
         -DOPENSSL_SSL_LIBRARY=/usr/lib/aarch64-linux-gnu/libssl.so" \
    && ok=0 \
    && for attempt in 1 2 3 4; do \
         if colcon build --executor sequential --cmake-args ${CMAKE_ARGS}; then ok=1; break; fi; \
         echo ">>> colcon attempt $attempt failed (see QEMU note above); retrying"; \
       done \
    && if [ "$ok" != 1 ]; then echo ">>> all colcon attempts failed"; exit 1; fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-humble-rviz2 \
    && rm -rf /var/lib/apt/lists/*


RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iproute2 \
        iputils-ping \
        tcpdump \
    && rm -rf /var/lib/apt/lists/*

COPY config/cyclonedds_gos.xml ./config/cyclonedds_gos.xml
COPY config/fastdds_profile_gos.xml ./config/fastdds_profile_gos.xml
RUN touch /root/ros_ws/.here

# Auto-source ROS + the built overlay.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /root/ros_ws/install/setup.bash" >> /root/.bashrc


RUN printf '%s\n' \
        '#!/bin/bash' \
        'set -e' \
        'source /opt/ros/${ROS_DISTRO}/setup.bash' \
        'source /root/ros_ws/install/setup.bash' \
        'exec "$@"' \
        > /ros_entrypoint.sh \
    && chmod +x /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
