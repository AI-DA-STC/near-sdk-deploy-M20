digraph G {
    // CMU Autonomy Stack — online navigation in unknown environments
    // Conference-paper style mirroring glim_nav2_arch.
    rankdir=TB;
    splines=spline;
    nodesep=0.32;
    ranksep=0.50;
    bgcolor="white";
    fontname="Helvetica";
    compound=true;
    newrank=true;

    node [
        fontname="Helvetica-Bold",
        fontsize=11,
        shape=box,
        style="filled,rounded",
        penwidth=1.6,
        margin="0.18,0.10",
    ];
    edge [
        fontname="Helvetica",
        fontsize=9,
        penwidth=1.4,
        arrowsize=0.85,
        color="#222222",
    ];

    subgraph cluster_online {
        label = "ONLINE  ·  Navigation in Unknown Environments  (CMU Autonomy Stack)";
        labelloc = "t";
        labeljust = "l";
        fontname = "Helvetica-Bold";
        fontsize = 13;
        style = "rounded,filled";
        fillcolor = "#F4F8F2";
        color = "#1E6B2F";
        penwidth = 1.8;
        margin = 14;

        // ---- Sensors + Goal source (top row) ----
        sensors [
            label="Sensors\nLiDAR · IMU",
            fillcolor="#2E7D32", fontcolor="white", color="#173F19",
        ];
        goal_in [
            label="Goal Source\n(user click /\nmission)",
            fillcolor="#FDEBD0", fontcolor="#7B3E0E", color="#B9770E",
            shape=note, penwidth=1.4,
        ];

        // ---- State estimation (Point-LIO) ----
        point_lio [
            label="Point-LIO\nTightly-Coupled Iterated EKF\nLiDAR-Inertial Odometry",
            fillcolor="#0E7C86", fontcolor="white", color="#063C42",
        ];

        // -----------------------------------------------------
        // HIGH-LEVEL PLANNING  (FAR Planner)
        // -----------------------------------------------------
        subgraph cluster_high {
            label = "High-Level Planning";
            labelloc = "t";
            labeljust = "l";
            fontname = "Helvetica-Bold";
            fontsize = 11;
            style = "rounded,filled";
            fillcolor = "#FFF6F2";
            color = "#7B1E12";
            penwidth = 1.4;
            margin = 12;

            far_planner [
                label="FAR Planner\nVisibility-Graph based\nexploration & navigation\n(incremental v-graph build,\nA* search on graph)",
                fillcolor="#C0392B", fontcolor="white", color="#7B1E12",
            ];
            graph_decoder [
                label="Graph Decoder\n(visibility graph\nserialize / load)",
                fillcolor="#E67E22", fontcolor="white", color="#7B3E0E",
            ];

            far_planner -> graph_decoder [label=" /robot_vgraph",
                                          fontsize=8, dir=both,
                                          arrowtail=normal, arrowhead=normal,
                                          style=dashed, color="#7B1E12"];
        }

        // -----------------------------------------------------
        // LOW-LEVEL PLANNING & CONTROL
        // -----------------------------------------------------
        subgraph cluster_low {
            label = "Low-Level Planning & Control  (terrain traversability + collision avoidance)";
            labelloc = "t";
            labeljust = "l";
            fontname = "Helvetica-Bold";
            fontsize = 11;
            style = "rounded,filled";
            fillcolor = "#F2F0FB";
            color = "#3A237D";
            penwidth = 1.4;
            margin = 12;

            // perception sub-row
            sensor_scan_gen [
                label="Sensor Scan Generation\n(point-cloud at-scan\nframe transform)",
                fillcolor="#7E6BC4", fontcolor="white", color="#3A237D",
            ];
            terrain_analysis [
                label="Terrain Analysis\n(local elevation grid,\nobstacle / ground\nseparation)",
                fillcolor="#7E6BC4", fontcolor="white", color="#3A237D",
            ];
            terrain_analysis_ext [
                label="Terrain Analysis Ext\n(extended-range\ntraversability map)",
                fillcolor="#7E6BC4", fontcolor="white", color="#3A237D",
            ];

            // control sub-row
            local_planner [
                label="Local Planner\nCollision avoidance over\nprecomputed trajectory\nlibrary, scored on\nterrain obstacles",
                fillcolor="#5B3FAD", fontcolor="white", color="#2A1A66",
            ];
            path_follower [
                label="Path Follower\nLookahead pure-pursuit\nsteering + speed\nregulation",
                fillcolor="#3A237D", fontcolor="white", color="#1A0F40",
            ];

            // intra-cluster edges
            terrain_analysis -> terrain_analysis_ext [label=" /terrain_map", fontsize=8];
            terrain_analysis -> local_planner        [label=" /terrain_map", fontsize=8];
            local_planner    -> path_follower        [label=" /path",        fontsize=8];
        }

        // ---- Robot ----
        robot [
            label="Robot (M20)\nBase / Motor Drivers",
            fillcolor="#222222", fontcolor="white", color="black",
            shape=box3d, penwidth=1.8,
        ];

        // ---- Layout pinning inside the online cluster ----
        { rank=same; sensors; goal_in; }
        { rank=same; sensor_scan_gen; terrain_analysis; terrain_analysis_ext; }
        { rank=same; far_planner; local_planner; }

        // ---- Cross-edges with topic labels ----
        sensors  -> point_lio [label=" /points  /imu"];

        // Point-LIO feeds the entire low-level cluster (cluster-level edge)
        point_lio -> sensor_scan_gen [
            label=" /registered_scan\n /state_estimation\n /tf  map→sensor",
            lhead=cluster_low,
        ];

        // Goal → FAR Planner
        goal_in -> far_planner [
            label=" /goal_point",
            lhead=cluster_high,
            color="#7B1E12", fontcolor="#7B1E12",
        ];

        // Low-level perception → High-level FAR Planner (single bundled edge)
        terrain_analysis_ext -> far_planner [
            label=" /sensor_scan\n /state_estimation_at_scan\n /terrain_map\n /terrain_map_ext",
            ltail=cluster_low, lhead=cluster_high,
            constraint=false, color="#7B1E12",
        ];

        // High-level → Low-level (waypoint command)
        far_planner -> local_planner [
            label=" /way_point\n /navigation_boundary\n /speed",
            ltail=cluster_high, lhead=cluster_low,
            penwidth=1.8, color="#7B1E12",
        ];

        // Path follower → Robot
        path_follower -> robot [label=" /cmd_vel"];
    }
}
