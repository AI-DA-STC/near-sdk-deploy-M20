digraph G {
    rankdir=TB;
    splines=spline;
    nodesep=0.32;
    ranksep=0.45;
    bgcolor="white";
    fontname="Helvetica";
    compound=true;
    newrank=true;

    // ---- Figure title ----
    label = <<FONT POINT-SIZE="18" FACE="Helvetica-Bold">GLIM + Nav2 Navigation Architecture</FONT><BR/><FONT POINT-SIZE="12" FACE="Helvetica">Offline 3D LiDAR-Inertial Mapping &amp; Sparse Waypoint Generation · Online Nav2 Execution with AMCL Relocalization</FONT><BR/> >;
    labelloc = "t";
    labeljust = "c";
    fontsize = 16;

    node [
        fontname="Helvetica-Bold",
        fontsize=11,
        shape=box,
        style="filled,rounded",
        penwidth=1.6,
        margin="0.18,0.10",
    ];
    edge [
        fontname="Helvetica",
        fontsize=9,
        penwidth=1.4,
        arrowsize=0.85,
        color="#222222",
    ];

    // ============================================================
    // OFFLINE PHASE  (single horizontal row)
    // ============================================================
    subgraph cluster_offline {
        label = "OFFLINE  ·  Mapping & Sparse Waypoint Generation";
        labelloc = "t";
        labeljust = "l";
        fontname = "Helvetica-Bold";
        fontsize = 13;
        style = "rounded,filled";
        fillcolor = "#F2F6FB";
        color = "#1F4E79";
        penwidth = 1.8;
        margin = 14;

        glim     [label="GLIM SLAM\n(LiDAR + IMU)",
                  fillcolor="#1F4E79", fontcolor="white", color="#0E2A44"];
        mapproc  [label="Map Processing\n(PCD → 2D occupancy,\nfiltering / inflation)",
                  fillcolor="#3B7DB8", fontcolor="white", color="#1F4E79"];
        swagger  [label="SWAGGER\nSparse Waypoint\nGraph Generation",
                  fillcolor="#C0392B", fontcolor="white", color="#7B1E12"];
        wpgraph  [label="Waypoint Graph\n(nodes + edges,\nsaved to disk)",
                  shape=folder, fillcolor="#FDEBD0", color="#B9770E"];

        glim    -> mapproc  [label=" /points (3D)\n /tf  map→odom"];
        mapproc -> swagger  [label=" /map\n (occupancy grid)"];
        swagger -> wpgraph  [label=" waypoint graph"];
    }

    // ============================================================
    // ONLINE PHASE
    // ============================================================
    subgraph cluster_online {
        label = "ONLINE  ·  Execution  (Nav2 stack)";
        labelloc = "t";
        labeljust = "l";
        fontname = "Helvetica-Bold";
        fontsize = 13;
        style = "rounded,filled";
        fillcolor = "#F4F8F2";
        color = "#1E6B2F";
        penwidth = 1.8;
        margin = 14;

        // Top row: sensing + map serving
        sensors  [label="Sensors\nLiDAR · IMU · Wheel Odom",
                  fillcolor="#2E7D32", fontcolor="white", color="#173F19"];
        mapsrv   [label="Map Server\n(serves prior /map)",
                  fillcolor="#6BAF73", fontcolor="white", color="#2E7D32"];

        // Localization
        amcl     [label="AMCL\nAdaptive Monte-Carlo\nLocalization on /map",
                  fillcolor="#0E7C86", fontcolor="white", color="#063C42"];

        // ---------- HIGH-LEVEL PLANNING ----------
        subgraph cluster_high {
            label = "High-Level Planning";
            labelloc = "t";
            labeljust = "l";
            fontname = "Helvetica-Bold";
            fontsize = 11;
            style = "rounded,filled";
            fillcolor = "#FFF6F2";
            color = "#7B1E12";
            penwidth = 1.4;
            margin = 10;

            graphsearch [label="Graph Search\n(A* / Dijkstra over\nSWAGGER waypoint graph)",
                         fillcolor="#E67E22", fontcolor="white", color="#7B3E0E"];
            navfn       [label="NavFn\nGlobal Planner\n(Dijkstra on\nglobal costmap)",
                         fillcolor="#C0392B", fontcolor="white", color="#7B1E12"];
            graphsearch -> navfn [label=" /waypoints\n (sparse)"];
        }

        // ---------- LOW-LEVEL PLANNING ----------
        subgraph cluster_low {
            label = "Low-Level Planning & Control";
            labelloc = "t";
            labeljust = "l";
            fontname = "Helvetica-Bold";
            fontsize = 11;
            style = "rounded,filled";
            fillcolor = "#F2F0FB";
            color = "#3A237D";
            penwidth = 1.4;
            margin = 10;

            lcostmap [label="Local Costmap\n(rolling window,\ninflation layer)",
                      fillcolor="#7E6BC4", fontcolor="white", color="#3A237D"];
            dwb      [label="DWB Local Planner\n(Dynamic Window Approach:\ntrajectory rollouts +\ncritic scoring)",
                      fillcolor="#5B3FAD", fontcolor="white", color="#2A1A66"];
            pfc      [label="Path Following Controller\n(Regulated Pure Pursuit:\nlookahead tracking,\nspeed regulation)",
                      fillcolor="#3A237D", fontcolor="white", color="#1A0F40"];

            lcostmap -> dwb [label=" /local_costmap"];
            dwb      -> pfc [label=" /local_plan"];
        }

        robot    [label="Robot (M20)\nBase / Motor Drivers",
                  fillcolor="#222222", fontcolor="white", color="black",
                  shape=box3d, penwidth=1.8];

        // ---- Online edges ----
        { rank=same; sensors; mapsrv; }
        { rank=same; graphsearch; lcostmap; }
        { rank=same; navfn; dwb; }

        sensors  -> amcl        [label=" /scan  /points\n /imu  /odom"];
        mapsrv   -> amcl        [label=" /map"];
        amcl     -> graphsearch [label=" /amcl_pose\n /tf  map→odom",
                                 lhead=cluster_high];
        sensors  -> lcostmap    [label=" /scan  /points",
                                 constraint=false];

        // global plan crosses from high → low cluster
        navfn -> dwb [label=" /plan\n (nav_msgs/Path)",
                      ltail=cluster_high, lhead=cluster_low,
                      penwidth=1.8, color="#7B1E12"];

        pfc   -> robot [label=" /cmd_vel"];
        robot -> sensors [label=" /odom\n /tf  odom→base_link",
                          style=dashed, color="#666666",
                          constraint=false];
    }

    // Force offline cluster above online cluster
    swagger -> sensors [style=invis, weight=10];
    wpgraph -> mapsrv  [style=invis, weight=10];

    // Bridge offline → online (loads waypoint graph)
    wpgraph -> graphsearch [label=" load waypoint graph",
                            style=dashed, color="#7B1E12",
                            penwidth=1.6, lhead=cluster_high,
                            fontcolor="#7B1E12"];
}
